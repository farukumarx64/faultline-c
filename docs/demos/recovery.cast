{"version": 2, "width": 112, "height": 30, "timestamp": 1791027106, "title": "Faultline: one job survives a worker crash", "env": {"TERM": "xterm-256color", "SHELL": "/bin/sh"}}
[0.510295, "o", "\u001b[2J\u001b[HFAULTLINE / RECOVERY DEMO\r\n1 / TWO WORKERS READY\r\n----------------------------------------------------------------------------\r\n\r\n$ ./build/debug/faultline workers \\\r\n    --coordinator 127.0.0.1:49609\r\nworkers=2 heartbeat_timeout_ms=6000\r\nWORKER_ID  LIVENESS HEARTBEAT_AGE_MS     JOB_ID               ATTEMPT\r\n1          ALIVE    243                  none                 0\r\n2          ALIVE    240                  none                 0\r\n\r\n# worker_id=1 belongs to demo-owned PID 95884\r\n# worker_id=2 belongs to demo-owned PID 95885\r\n# Both workers are connected before submission. No replacement is started.\r\n"]
[3.136017, "o", "\u001b[2J\u001b[HFAULTLINE / RECOVERY DEMO\r\n2 / ONE ACKNOWLEDGED JOB IS RUNNING\r\n----------------------------------------------------------------------------\r\n\r\n$ ./build/debug/faultline submit sleep --args 6000 --max-retries 1 \\\r\n    --coordinator 127.0.0.1:49609\r\njob_id=1\r\n\r\n$ ./build/debug/faultline status 1 \\\r\n    --coordinator 127.0.0.1:49609\r\njob_id=1\r\nstate=RUNNING\r\nworker_id=1\r\nattempt=1\r\nretries=0/1\r\nfailure=NONE\r\nresult_bytes=0\r\n\r\n# Remember this job ID. Its retry allowance is exactly one.\r\n"]
[5.678158, "o", "\u001b[2J\u001b[HFAULTLINE / RECOVERY DEMO\r\n3 / HARD CRASH THE BUSY WORKER\r\n----------------------------------------------------------------------------\r\n\r\n$ kill -KILL 95884\r\n\r\n# Sent SIGKILL to worker_id=1, the owner of job_id=1, attempt=1.\r\n# Worker 2 was already connected and remains alive.\r\n# Waiting for the coordinator to reassign the same job...\r\n"]
[8.24324, "o", "\u001b[2J\u001b[HFAULTLINE / RECOVERY DEMO\r\n4 / SAME JOB, ANOTHER WORKER\r\n----------------------------------------------------------------------------\r\n\r\n$ ./build/debug/faultline status 1 \\\r\n    --coordinator 127.0.0.1:49609\r\njob_id=1\r\nstate=RUNNING\r\nworker_id=2\r\nattempt=2\r\nretries=1/1\r\nfailure=NONE\r\nresult_bytes=0\r\n\r\n# job_id=1 is unchanged. Worker 1 -> worker 2.\r\n# attempt=2; retries=1/1. The sleep task starts again from the beginning.\r\n# Waiting for its real completion; no time is fast-forwarded.\r\n"]
[12.292516, "o", "\u001b[2J\u001b[HFAULTLINE / RECOVERY DEMO\r\n5 / VERIFIED: THE SAME JOB COMPLETED\r\n----------------------------------------------------------------------------\r\n\r\n$ ./build/debug/faultline status 1 \\\r\n    --coordinator 127.0.0.1:49609\r\njob_id=1\r\nstate=DONE\r\nworker_id=2\r\nattempt=2\r\nretries=1/1\r\nfailure=NONE\r\nresult_bytes=13\r\nresult=\"slept_ms=6000\"\r\n\r\n# PASS: one submission, two attempts, one retry, one accepted result.\r\n# Worker 1 was killed; existing worker 2 completed the job.\r\n# Cleanup passed: all owned processes reaped; no process groups left.\r\n"]
[14.797649, "o", ""]
