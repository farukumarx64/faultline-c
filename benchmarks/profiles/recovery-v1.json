{
  "contract": "faultline-benchmarks-v1",
  "profile": "recovery-sleep-v1",
  "task": "sleep",
  "arguments": "10000",
  "expected_result": "slept_ms=10000",
  "expected_result_bytes": 14,
  "jobs": 32,
  "workers": 4,
  "max_retries": 1,
  "scenarios": {
    "no_fault": {"faults_per_run": 0},
    "sigkill": {"faults_per_run": 1, "signal": "SIGKILL"},
    "heartbeat_expiry": {
      "faults_per_run": 1,
      "signal": "SIGSTOP",
      "pause_duration_ms": 10000,
      "resume_signal": "SIGCONT"
    }
  },
  "fault_target": "first_acknowledged_job_attempt_1",
  "fault_delay_after_started_observation_ms": 500,
  "replacement_policy": "one_replacement_after_matching_durable_worker_loss",
  "warmup_order": ["no_fault", "sigkill", "heartbeat_expiry"],
  "measured_rounds": [
    ["no_fault", "sigkill", "heartbeat_expiry"],
    ["sigkill", "heartbeat_expiry", "no_fault"],
    ["heartbeat_expiry", "no_fault", "sigkill"],
    ["heartbeat_expiry", "sigkill", "no_fault"],
    ["sigkill", "no_fault", "heartbeat_expiry"]
  ],
  "build": {
    "cc": "clang",
    "cflags": "-O2 -g -Werror",
    "sanitize": 0,
    "cpu_tuning": "compiler_default",
    "lto": false
  },
  "heartbeat_interval_ms": 2000,
  "heartbeat_timeout_ms": 6000,
  "poll_interval_ms": 200,
  "cooldown_ms": 30000,
  "run_deadline_ms": 600000,
  "cleanup_reserve_ms": 10000,
  "campaign_deadline_ms": 7200000
}
